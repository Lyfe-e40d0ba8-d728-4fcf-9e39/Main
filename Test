-- ── Notification Queue & Display ───────────────────────────────────
-- FIX: Queue system menggantikan bool flag agar notifikasi tidak hilang
local _notifQueue   = {}
local _notifRunning = false

local function processNotifQueue()
    if _notifRunning then return end
    _notifRunning = true

    task.spawn(function()
        while #_notifQueue > 0 do
            local cfg = table.remove(_notifQueue, 1)
            local duration  = cfg.duration or cfg.Duration or 5
            local onComplete = cfg.OnComplete or cfg.onComplete

            local screen     = getNotifScreen()
            local MainFrame, ProgressFill, Shimmer = BuildNotifFrame(screen, cfg)

            local targetPos  = UDim2.new(1, -(notifWidth + notifPosX), 1, -(notifHeight + notifPosY))
            local exitPos    = UDim2.new(1, notifWidth + 20, 1, -(notifHeight + notifPosY))
            local slideInInfo  = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            local slideOutInfo = TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

            -- Slide in
            TweenService:Create(MainFrame, slideInInfo, {Position = targetPos}):Play()

            -- Shimmer loop
            -- FIX: Loop di-track agar berhenti bersama frame
            local shimmerRunning = true
            task.spawn(function()
                while shimmerRunning and MainFrame and MainFrame.Parent do
                    TweenService:Create(Shimmer, TweenInfo.new(1.5, Enum.EasingStyle.Linear), {
                        Position = UDim2.new(1.2, 0, 0, 0),
                    }):Play()
                    task.wait(3.2)
                    if shimmerRunning and MainFrame and MainFrame.Parent then
                        Shimmer.Position = UDim2.new(-0.35, 0, 0, 0)
                    end
                end
            end)

            -- Progress tween
            TweenService:Create(ProgressFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
                Size = UDim2.new(0, 0, 1, 0),
            }):Play()

            task.wait(duration)
            shimmerRunning = false

            -- Slide out
            local slideOut = TweenService:Create(MainFrame, slideOutInfo, {Position = exitPos})
            slideOut:Play()
            slideOut.Completed:Wait()

            -- Cleanup frame
            if MainFrame and MainFrame.Parent then
                MainFrame:Destroy()
            end

            -- Cleanup screen jika kosong
            if _notifScreen and _notifScreen.Parent
                and #_notifScreen:GetChildren() == 0 then
                _notifScreen:Destroy()
                _notifScreen = nil
            end

            -- Callback
            if typeof(onComplete) == "function" then
                pcall(onComplete)
            end

            -- Jeda singkat antar notifikasi
            if #_notifQueue > 0 then
                task.wait(0.2)
            end
        end

        _notifRunning = false
    end)
end

-- FIX: ShowNotification sekarang menggunakan queue, tidak drop notif
local function ShowNotification(cfg)
    cfg = cfg or {}
    _notifQueue[#_notifQueue + 1] = cfg
    processNotifQueue()
end

-- Export ke global env
getgenv().ShowNotification = ShowNotification

-- ════════════════════════════════════════════════════════════════════
-- DRAGGABLE SYSTEM
-- FIX: InputChanged connection sekarang di-disconnect saat drag selesai
--      untuk menghindari memory leak akumulasi
-- ════════════════════════════════════════════════════════════════════

local DRAG_SMOOTHNESS = 17

local function getDragLerpAlpha(smoothValue)
    smoothValue = math.clamp(smoothValue or DRAG_SMOOTHNESS, 1, 20)
    return 1.0 - ((smoothValue - 1) / 19) * 0.9
end

local function makeDraggable(dragHandle, dragTarget, smoothness)
    local dragging      = false
    local dragStart     = nil
    local startPos      = nil
    local activeTouch   = nil
    local targetPosition = nil
    local lerpThread    = nil
    local lerpRunning   = false

    dragTarget = dragTarget or dragHandle

    local lerpAlpha = getDragLerpAlpha(smoothness)
    local smoothVal = math.clamp(smoothness or DRAG_SMOOTHNESS, 1, 20)
    local useLerp   = smoothVal > 3

    local function startLerpLoop()
        if lerpRunning then return end
        lerpRunning = true
        lerpThread  = task.spawn(function()
            -- FIX: Gunakan RunService.Heartbeat daripada task.wait()
            --      agar lerp sinkron dengan frame rate
            local heartbeat = RunService.Heartbeat
            while lerpRunning do
                heartbeat:Wait()
                if dragging and targetPosition then
                    local cp   = dragTarget.Position
                    local newX = cp.X.Offset + (targetPosition.X - cp.X.Offset) * lerpAlpha
                    local newY = cp.Y.Offset + (targetPosition.Y - cp.Y.Offset) * lerpAlpha
                    local snapX = math.abs(targetPosition.X - newX) < 0.5
                    local snapY = math.abs(targetPosition.Y - newY) < 0.5
                    if snapX and snapY then
                        dragTarget.Position = UDim2.new(
                            cp.X.Scale, targetPosition.X,
                            cp.Y.Scale, targetPosition.Y
                        )
                    else
                        dragTarget.Position = UDim2.new(
                            cp.X.Scale, newX,
                            cp.Y.Scale, newY
                        )
                    end
                end
            end
        end)
    end

    local function stopLerpLoop()
        lerpRunning = false
        if lerpThread then
            pcall(task.cancel, lerpThread)
            lerpThread = nil
        end
    end

    local function update(input)
        if not dragging or not dragStart or not startPos then return end
        local delta = input.Position - dragStart
        if useLerp then
            targetPosition = Vector2.new(
                startPos.X.Offset + delta.X,
                startPos.Y.Offset + delta.Y
            )
        else
            dragTarget.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end

    -- FIX: Simpan connection agar bisa di-disconnect
    local inputChangedConn = nil

    dragHandle.InputBegan:Connect(function(input)
        local it = input.UserInputType
        if it ~= Enum.UserInputType.MouseButton1
            and it ~= Enum.UserInputType.Touch then return end
        if dragging then return end

        dragging       = true
        dragStart      = input.Position
        startPos       = dragTarget.Position
        targetPosition = Vector2.new(startPos.X.Offset, startPos.Y.Offset)

        if it == Enum.UserInputType.Touch then
            activeTouch = input
        end

        if useLerp then startLerpLoop() end

        -- Track end dari input ini
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging    = false
                dragStart   = nil
                startPos    = nil

                if input == activeTouch then
                    activeTouch = nil
                end

                if useLerp then
                    task.delay(0.15, function()
                        if not dragging then
                            stopLerpLoop()
                            targetPosition = nil
                        end
                    end)
                end

                -- FIX: Disconnect InputChanged saat tidak drag
                if inputChangedConn then
                    inputChangedConn:Disconnect()
                    inputChangedConn = nil
                end
            end
        end)

        -- FIX: Buat connection baru hanya saat mulai drag
        inputChangedConn = UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local t = inp.UserInputType
            if t == Enum.UserInputType.MouseMovement then
                update(inp)
            elseif t == Enum.UserInputType.Touch and inp == activeTouch then
                update(inp)
            end
        end)
    end)

    -- Cleanup saat handle di-destroy
    dragHandle.Destroying:Connect(function()
        stopLerpLoop()
        if inputChangedConn then
            inputChangedConn:Disconnect()
            inputChangedConn = nil
        end
    end)
end

