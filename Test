    lbl.TextSize = 11
    lbl.TextColor3 = RX.T1
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.ZIndex = 5
    lbl.Parent = frame

    -- Toggle Track
    local track = Instance.new("Frame")
    track.Name = "ToggleTrack"
    track.Size = UDim2.new(0, 39, 0, 20)
    track.Position = UDim2.new(1, -(38 + 8), 0.5, 0)
    track.AnchorPoint = Vector2.new(0, 0.5)
    track.BackgroundColor3 = Color3.fromRGB(38, 38, 55)
    track.BackgroundTransparency = 0.25
    track.BorderSizePixel = 0
    track.ZIndex = 5
    track.Parent = frame

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track

    local trackStroke = Instance.new("UIStroke")
    trackStroke.Thickness = 1
    trackStroke.Color = Color3.fromRGB(55, 55, 80)
    trackStroke.Transparency = 1
    trackStroke.Parent = track

    -- Knob Toggle
    local knob = Instance.new("Frame")
    knob.Name = "Knob"
    knob.Size = UDim2.new(0, 15, 0, 15)
    knob.Position = UDim2.new(0, 2, 0.5, 0)
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.BackgroundColor3 = Color3.fromRGB(140, 140, 160)
    knob.BorderSizePixel = 0
    knob.ZIndex = 6
    knob.Parent = track

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    -- Invisible Button untuk Klik Toggle
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Name = "ToggleButton"
    toggleBtn.Size = UDim2.new(1, 0, 1, 0)
    toggleBtn.BackgroundTransparency = 1
    toggleBtn.Text = ""
    toggleBtn.ZIndex = 8
    toggleBtn.Parent = track

    -- State & Animasi
    local knobOnX = 39 - 15 - 2
    local state = cfg.default == true

    local function setToggleState(en)
        if en then
            TweenService:Create(knob,
                TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {
                    Position = UDim2.new(0, knobOnX, 0.5, 0),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                }
            ):Play()
            TweenService:Create(track, TWEEN_NORMAL, {
                BackgroundColor3 = RX.Green,
            }):Play()
            TweenService:Create(trackStroke, TWEEN_NORMAL, {
                Color = RX.Green,
                Transparency = 1,
            }):Play()
        else
            TweenService:Create(knob,
                TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                {
                    Position = UDim2.new(0, 2, 0.5, 0),
                    BackgroundColor3 = Color3.fromRGB(140, 140, 160),
                }
            ):Play()
            TweenService:Create(track, TWEEN_NORMAL, {
                BackgroundColor3 = Color3.fromRGB(38, 38, 55),
            }):Play()
            TweenService:Create(trackStroke, TWEEN_NORMAL, {
                Color = Color3.fromRGB(55, 55, 80),
                Transparency = 1,
            }):Play()
        end
    end

    -- Set visual awal tanpa animasi
    if state then
        knob.Position = UDim2.new(0, knobOnX, 0.5, 0)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        track.BackgroundColor3 = RX.Green
        trackStroke.Color = RX.Green
        trackStroke.Transparency = 0.3
    end

    -- Event Toggle Klik
    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        setToggleState(state)
        if cfg.onToggle then
            task.spawn(function()
                pcall(cfg.onToggle, state)
            end)
        end
    end)

    -- Auto Cleanup saat frame dihancurkan
    frame.Destroying:Connect(function()
        if state and cfg.onToggle then
            pcall(cfg.onToggle, false)
        end
    end)

    return {
        SetState = function(s, silent)
            s = s == true
            if state == s then return end
            state = s
            setToggleState(state)
            if not silent and cfg.onToggle then
                task.spawn(function()
                    pcall(cfg.onToggle, state)
                end)
            end
        end,

        GetState = function()
            return state
        end,

        Frame = frame,
        Button = toggleBtn,
    }
end -- end Components.Toggle

