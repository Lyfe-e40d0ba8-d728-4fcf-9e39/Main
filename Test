        local originalTransparencies = {}

        -- FIX: cacheOriginalValues — indentasi semua branch diperbaiki
        local function cacheOriginalValues()
            originalTransparencies = {}

            local function cacheObj(obj)
                if not obj or not obj.Parent then return end
                local t = {}

                if obj:IsA("Frame") then
                    t.BackgroundTransparency = obj.BackgroundTransparency
                elseif obj:IsA("TextLabel") then
                    t.TextTransparency       = obj.TextTransparency
                    t.BackgroundTransparency = obj.BackgroundTransparency
                elseif obj:IsA("TextButton") then
                    t.TextTransparency       = obj.TextTransparency
                    t.BackgroundTransparency = obj.BackgroundTransparency
                elseif obj:IsA("TextBox") then
                    t.TextTransparency       = obj.TextTransparency
                    t.BackgroundTransparency = obj.BackgroundTransparency
                elseif obj:IsA("ImageLabel") then
                    t.ImageTransparency      = obj.ImageTransparency
                    t.BackgroundTransparency = obj.BackgroundTransparency
                elseif obj:IsA("UIStroke") then
                    t.Transparency = obj.Transparency
                elseif obj:IsA("ScrollingFrame") then
                    t.ScrollBarImageTransparency = obj.ScrollBarImageTransparency
                    t.BackgroundTransparency     = obj.BackgroundTransparency
                end

                if next(t) then
                    originalTransparencies[obj] = t
                end
            end

            cacheObj(MainFrame)
            for _, desc in ipairs(MainFrame:GetDescendants()) do
                cacheObj(desc)
            end
            cacheObj(ExtraFrame)
            for _, desc in ipairs(ExtraFrame:GetDescendants()) do
                cacheObj(desc)
            end
        end

        task.delay(0.1, cacheOriginalValues)

        local function fadeAllTo(targetAlpha, dur, callback)
            local tweenI = TweenInfo.new(dur, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            for obj, props in pairs(originalTransparencies) do
                if obj and obj.Parent then
                    local tp = {}
                    for pn, ov in pairs(props) do
                        tp[pn] = (targetAlpha == 0) and ov or 1
                    end
                    if next(tp) then
                        TweenService:Create(obj, tweenI, tp):Play()
                    end
                end
            end
            if callback then task.delay(dur, callback) end
        end

