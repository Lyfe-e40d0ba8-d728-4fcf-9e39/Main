local _cachedParent = nil

local function getParent()
    if _cachedParent then return _cachedParent end

    local ok, result
    if gethui then
        ok, result = pcall(gethui)
        if ok and result then
            _cachedParent = result
            return _cachedParent
        end
    end
    if get_hidden_ui then
        ok, result = pcall(get_hidden_ui)
        if ok and result then
            _cachedParent = result
            return _cachedParent
        end
    end

    _cachedParent = CoreGui
    return _cachedParent
end

