Components.Label("Main Features", 1)

local function CreateNPCVirusDetectorESP()
    -- ============================================================
    -- VARIABLES & STATE
    -- ============================================================
    local espEnabled         = false
    local espThread          = nil
    local monitorConnections = {}
    local npcCache           = {}
    local pendingNPCs        = {}

    local NPCFolder = workspace:FindFirstChild("Systems")
        and workspace.Systems:FindFirstChild("NPCs")

    -- ============================================================
    -- LOGIC ESP
    -- ============================================================

    local function GetInfectionStatus(npc)
        local infected  = false
        local virusName = "Human"
        pcall(function()
            local infectedAttr = npc:GetAttribute("Infected")
            infected = (infectedAttr == true)
            local virusAttr = npc:GetAttribute("Virus")
            if virusAttr and tostring(virusAttr) ~= "" then
                virusName = tostring(virusAttr)
            end
        end)
        return infected, virusName
    end

    local function CreateBillboardGUI(npc)
        local humanoidRootPart = npc:FindFirstChild("HumanoidRootPart")
            or npc:FindFirstChildWhichIsA("BasePart")
        if not humanoidRootPart then return nil end

        local billboard = Instance.new("BillboardGui")
        billboard.Name         = "VirusDetectorESP"
        billboard.Size         = UDim2.new(0, 120, 0, 50)
        billboard.MaxDistance  = 35
        billboard.StudsOffset  = Vector3.new(0, 5, 0)
        billboard.SizeOffset   = Vector2.new(0, 0)
        billboard.LightInfluence = 0
        billboard.ResetOnSpawn = false
        billboard.AlwaysOnTop  = true
        billboard.Parent       = humanoidRootPart

        -- Status Label
        local statusLabel = Instance.new("TextLabel")
        statusLabel.Name                  = "StatusLabel"
        statusLabel.Size                  = UDim2.new(1, 0, 0, 24)
        statusLabel.Position              = UDim2.new(0, 0, 0, 0)
        statusLabel.BackgroundTransparency = 0.2
        statusLabel.BackgroundColor3      = Color3.fromRGB(30, 30, 40)
        statusLabel.TextColor3            = Color3.fromRGB(255, 255, 255)
        statusLabel.TextSize              = 12
        statusLabel.Font                  = Enum.Font.GothamBold
        statusLabel.TextXAlignment        = Enum.TextXAlignment.Center
        statusLabel.BorderSizePixel       = 0
        statusLabel.Parent                = billboard

        local statusCorner = Instance.new("UICorner")
        statusCorner.CornerRadius = UDim.new(0, 4)
        statusCorner.Parent       = statusLabel

        local statusStroke = Instance.new("UIStroke")
        statusStroke.Thickness   = 1
        statusStroke.Color       = Color3.fromRGB(100, 100, 100)
        statusStroke.Transparency = 0.9
        statusStroke.Parent      = statusLabel

        -- Virus Label
        local virusLabel = Instance.new("TextLabel")
        virusLabel.Name                  = "VirusLabel"
        virusLabel.Size                  = UDim2.new(1, 0, 0, 22)
        virusLabel.Position              = UDim2.new(0, 0, 0, 26)
        virusLabel.BackgroundTransparency = 0.3
        virusLabel.BackgroundColor3      = Color3.fromRGB(25, 25, 35)
        virusLabel.TextColor3            = Color3.fromRGB(200, 200, 220)
        virusLabel.TextSize              = 12
        virusLabel.Font                  = Enum.Font.Gotham
        virusLabel.TextXAlignment        = Enum.TextXAlignment.Center
        virusLabel.BorderSizePixel       = 0
        virusLabel.Parent                = billboard

        local virusCorner = Instance.new("UICorner")
        virusCorner.CornerRadius = UDim.new(0, 4)
        virusCorner.Parent       = virusLabel

        local virusStroke = Instance.new("UIStroke")
        virusStroke.Thickness   = 1
        virusStroke.Color       = Color3.fromRGB(80, 80, 100)
        virusStroke.Transparency = 0.9
        virusStroke.Parent      = virusLabel

        return {
            Billboard    = billboard,
            StatusLabel  = statusLabel,
            VirusLabel   = virusLabel,
            StatusStroke = statusStroke,
            VirusStroke  = virusStroke,
            AttachedTo   = humanoidRootPart,
        }
    end

    local function UpdateESPDisplay(npc, guiData)
        if not guiData
            or not guiData.Billboard
            or not guiData.Billboard.Parent then return end

        local infected, virusName = GetInfectionStatus(npc)
        if infected then
            guiData.StatusLabel.Text             = "INFECTED"
            guiData.StatusLabel.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            guiData.StatusStroke.Color           = Color3.fromRGB(255, 100, 100)
        else
            guiData.StatusLabel.Text             = "NOT INFECTED"
            guiData.StatusLabel.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
            guiData.StatusStroke.Color           = Color3.fromRGB(100, 255, 100)
        end
        guiData.VirusLabel.Text = "TYPE : " .. virusName
    end

    local function AddNPCToESP(npc, retryCount)
        if not espEnabled or not npc or not npc.Parent then return end
        retryCount = retryCount or 0

        if npcCache[npc] then
            if npcCache[npc].Billboard and npcCache[npc].Billboard.Parent then
                UpdateESPDisplay(npc, npcCache[npc])
                return
            else
                npcCache[npc] = nil
            end
        end

        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        if not humanoid then
            if retryCount < 10 then pendingNPCs[npc] = retryCount + 1 end
            return
        end

        local success = false
        pcall(function()
            local guiData = CreateBillboardGUI(npc)
            if guiData then
                npcCache[npc] = guiData
                UpdateESPDisplay(npc, guiData)
                success = true

                local attributeConn = npc.AttributeChanged:Connect(function(attrName)
                    if (attrName == "Infected" or attrName == "Virus")
                        and npcCache[npc] then
                        UpdateESPDisplay(npc, npcCache[npc])
                    end
                end)

                local hrpRemovedConn = npc.ChildRemoved:Connect(function(child)
                    if child.Name == "HumanoidRootPart" and npcCache[npc] then
                        pcall(function()
                            if npcCache[npc].Billboard then
                                npcCache[npc].Billboard:Destroy()
                            end
                        end)
                        npcCache[npc].Billboard = nil
                    end
                end)

                local hrpAddedConn = npc.ChildAdded:Connect(function(child)
                    if child.Name == "HumanoidRootPart" and espEnabled then
                        npcCache[npc] = nil
                        task.wait(0.1)
                        AddNPCToESP(npc, 0)
                    end
                end)

                npcCache[npc].Connections = {
                    attributeConn,
                    hrpRemovedConn,
                    hrpAddedConn,
                }
            end
        end)

        if not success and retryCount < 10 then
            pendingNPCs[npc] = retryCount + 1
        end
    end

    local function RemoveNPCFromESP(npc)
        if npcCache[npc] then
            pcall(function()
                if npcCache[npc].Connections then
                    for _, conn in ipairs(npcCache[npc].Connections) do
                        if conn then conn:Disconnect() end
                    end
                end
                if npcCache[npc].Billboard then
                    npcCache[npc].Billboard:Destroy()
                end
            end)
            npcCache[npc] = nil
        end
        pendingNPCs[npc] = nil
    end

    local function ClearAllESP()
        for npc, guiData in pairs(npcCache) do
            pcall(function()
                if guiData.Connections then
                    for _, conn in ipairs(guiData.Connections) do
                        if conn then conn:Disconnect() end
                    end
                end
                if guiData.Billboard then guiData.Billboard:Destroy() end
            end)
        end
        npcCache     = {}
        pendingNPCs  = {}
    end

    local function ScanExistingNPCs()
        if not NPCFolder then return end
        local npcs      = NPCFolder:GetChildren()
        local batchSize = 10
        for i, npc in ipairs(npcs) do
            if not espEnabled then break end
            AddNPCToESP(npc, 0)
            if i % batchSize == 0 then task.wait(0.05) end
        end
    end

    local function DisconnectMonitors()
        for _, conn in ipairs(monitorConnections) do
            if conn then pcall(function() conn:Disconnect() end) end
        end
        monitorConnections = {}
    end

    local function MonitorNPCFolder()
        if not NPCFolder then return end
        DisconnectMonitors()

        local childAddedConn = NPCFolder.ChildAdded:Connect(function(npc)
            if not espEnabled then return end
            AddNPCToESP(npc, 0)
            task.delay(0.3, function()
                if espEnabled and npc and npc.Parent then AddNPCToESP(npc, 0) end
            end)
            task.delay(0.8, function()
                if espEnabled and npc and npc.Parent then AddNPCToESP(npc, 0) end
            end)
        end)

        local childRemovedConn = NPCFolder.ChildRemoved:Connect(function(npc)
            RemoveNPCFromESP(npc)
        end)

        local descendantAddedConn = NPCFolder.DescendantAdded:Connect(function(descendant)
            if not espEnabled then return end
            if descendant:IsA("Humanoid") or descendant.Name == "HumanoidRootPart" then
                local npc = descendant.Parent
                if npc and npc.Parent == NPCFolder then
                    task.wait(0.1)
                    if espEnabled and npc and npc.Parent then
                        AddNPCToESP(npc, 0)
                    end
                end
            end
        end)

        table.insert(monitorConnections, childAddedConn)
        table.insert(monitorConnections, childRemovedConn)
        table.insert(monitorConnections, descendantAddedConn)
    end

    local function RunESPLoop()
        if espThread then
            pcall(function() task.cancel(espThread) end)
            espThread = nil
        end

        espThread = task.spawn(function()
            local scanInterval = 0
            while espEnabled do
                pcall(function()
                    -- Cek NPC yang sudah di-cache
                    local npcToRemove = {}
                    for npc, guiData in pairs(npcCache) do
                        if npc and npc.Parent then
                            if guiData and guiData.Billboard and guiData.Billboard.Parent then
                                UpdateESPDisplay(npc, guiData)
                            else
                                if guiData and guiData.Connections then
                                    for _, conn in ipairs(guiData.Connections) do
                                        if conn then
                                            pcall(function() conn:Disconnect() end)
                                        end
                                    end
                                end
                                npcCache[npc]    = nil
                                pendingNPCs[npc] = 0
                            end
                        else
                            table.insert(npcToRemove, npc)
                        end
                    end

                    for _, npc in ipairs(npcToRemove) do
                        RemoveNPCFromESP(npc)
                    end

                    -- Resolve pending NPC
                    local resolvedPending = {}
                    for npc, retryCount in pairs(pendingNPCs) do
                        if not espEnabled then break end
                        if npc and npc.Parent then
                            AddNPCToESP(npc, retryCount)
                            if npcCache[npc] then
                                table.insert(resolvedPending, npc)
                            end
                        else
                            table.insert(resolvedPending, npc)
                        end
                    end

                    for _, npc in ipairs(resolvedPending) do
                        pendingNPCs[npc] = nil
                    end

                    -- Scan periodik setiap 25 iterasi (~5 detik)
                    scanInterval = scanInterval + 1
                    if scanInterval >= 25 then
                        scanInterval = 0
                        if NPCFolder then
                            for _, npc in ipairs(NPCFolder:GetChildren()) do
                                if not npcCache[npc]
                                    and not pendingNPCs[npc]
                                    and npc and npc.Parent then
                                    AddNPCToESP(npc, 0)
                                end
                            end
                        end
                    end
                end)
                task.wait(0.2)
            end
        end)
    end

    local function StartESP()
        task.spawn(function()
            ScanExistingNPCs()
            task.wait(0.1)
            MonitorNPCFolder()
            task.wait(0.05)
            RunESPLoop()
        end)
    end

    local function StopESP()
        ClearAllESP()
        DisconnectMonitors()
        if espThread then
            pcall(function() task.cancel(espThread) end)
            espThread = nil
        end
    end

    -- ============================================================
    -- UI TOGGLE
    -- ============================================================
    Components.Toggle({
        label       = "Show Virus Detector",
        layoutOrder = 2,
        default     = false,
