-- RANDOM NAME SYSTEM
-- ════════════════════════════════════════════════════════════════════

math.randomseed(os.clock() * 1e9 + tick() * 1e6)

local _rnd = math.random
local _charset = {}
local _weirdChar  = "?"
local _weirdChance = 0.25

do
    for i = 33, 126 do
        _charset[#_charset + 1] = string.char(i)
    end
end

local _charLen = #_charset

local function randomName(len)
    len = len or _rnd(15, 25)
    local buf = table.create(len)
    for i = 1, len do
        if _rnd() < _weirdChance then
            buf[i] = _weirdChar
        else
            buf[i] = _charset[_rnd(_charLen)]
        end
    end
    return table.concat(buf)
end

