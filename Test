-- CONTAINER SCANNER
-- ════════════════════════════════════════════════════════════════════

local function getAllContainers()
    local seen = {}
    local containers = {}

    local function addContainer(c)
        if c and not seen[c] then
            seen[c] = true
            containers[#containers + 1] = c
        end
    end

    addContainer(CoreGui)

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then addContainer(pg) end

    if gethui then
        local ok, result = pcall(gethui)
        if ok and result then addContainer(result) end
    end
    if get_hidden_ui then
        local ok, result = pcall(get_hidden_ui)
        if ok and result then addContainer(result) end
    end

    return containers
end

-- ════════════════════════════════════════════════════════════════════
-- CLEANUP SYSTEM
-- ════════════════════════════════════════════════════════════════════

local function destroyExistingFlycer()
    if g[FLAG_NAME] then
        local old = g[GUI_REF_NAME]
        if old and typeof(old) == "Instance" and old.Parent then
            pcall(function() old:Destroy() end)
        end
    end

    if g._FlycerGUI and typeof(g._FlycerGUI) == "Instance" then
        pcall(function()
            if g._FlycerGUI.Parent then
                g._FlycerGUI:Destroy()
            end
        end)
        g._FlycerGUI = nil
    end

    for _, container in ipairs(getAllContainers()) do
        pcall(function()
            local children = container:GetChildren()
            for _, child in ipairs(children) do
                if child:IsA("ScreenGui")
                    and child:GetAttribute(FLYCER_TAG_ATTR) == true then
                    child:Destroy()
                end
            end
        end)
    end

    g[FLAG_NAME]   = nil
    g[GUI_REF_NAME] = nil
end

local function removeOldFlycerGUI()
    for _, container in ipairs(getAllContainers()) do
        pcall(function()
            local children = container:GetChildren()
            for _, child in ipairs(children) do
                if child:IsA("ScreenGui")
                    and (child.Name == "SettingsMenu"
                    or child:GetAttribute(FLYCER_TAG_ATTR) == true) then
                    child:Destroy()
                end
            end
        end)
    end
end

