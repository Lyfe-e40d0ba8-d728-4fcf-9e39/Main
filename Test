--// Noclip Logic
local NoclipConnection = nil

local function Noclip(enable)
    if enable then
        -- RunService.Stepped runs right before physics simulation
        NoclipConnection = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

--// ESP Logic
local espEnabled = false

local function AddESP(character)
    if not character:FindFirstChild("ESPHighlight") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
        highlight.FillTransparency = 0.3
        highlight.OutlineTransparency = 0
        highlight.Parent = character
    end
end

local function RemoveESP(character)
    local highlight = character:FindFirstChild("ESPHighlight")
    if highlight then
        highlight:Destroy()
    end
end

local function UpdateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if espEnabled then
                AddESP(player.Character)
            else
                RemoveESP(player.Character)
            end
        end
    end
end

-- Handle character respawns and new players for ESP
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(char)
        if espEnabled then AddESP(char) end
    end)
end)

for _, player in pairs(Players:GetPlayers()) do
    player.CharacterAdded:Connect(function(char)
        if espEnabled and player ~= LocalPlayer then AddESP(char) end
    end)
end

local function Esp(enable)
    espEnabled = enable
    UpdateESP()
end

--========================================================--
--                  AUTOPLAYER LOGIC                      --
--========================================================--

local accuracyBounds = { Perfect = -0, Great = -100, Okay = -100 }
local currentAccuracy = "Perfect"
local noteTimeTarget = accuracyBounds[currentAccuracy]

local trackSystem = nil
local originalTrackNew = nil
local autoPlayerEnabled = false

-- Locate Track System once on load rather than every toggle
for _, module in next, getloadedmodules() do 
    local moduleValue = require(module)
    if type(moduleValue) == "table" then 
        local newFunction = rawget(moduleValue, "new")
        if newFunction then 
            local firstUpvalue = getupvalues(newFunction)[1]
            if type(firstUpvalue) == "table" and rawget(firstUpvalue, "twister") then 
                trackSystem = moduleValue
                break
            end
        end
    end
end

local function getTrackActionFunctions(system)
    local pressTrack, releaseTrack 
    for _, trackFunc in next, system do 
        if type(trackFunc) == "function" then 
            local constants = getconstants(trackFunc)
            if table.find(constants, "press") then 
                pressTrack = trackFunc
            elseif table.find(constants, "release") then 
                releaseTrack = trackFunc
            end
            if pressTrack and releaseTrack then break end
        end
    end
    return pressTrack, releaseTrack
end

local function getLocalTrackSystem(session)
    local localSlotIndex = getupvalue(session.set_local_game_slot, 1)
    for _, sessionFunc in next, session do 
        if type(sessionFunc) == "function" then 
            local object = getupvalues(sessionFunc)[1]
            if type(object) == "table" and rawget(object, "count") and object:count() <= 4 then 
                return object:get(localSlotIndex)
            end
        end
    end
end

-- Hook setup function
local function SetupAutoPlayerHook()
    if not trackSystem then return end
    originalTrackNew = trackSystem.new

    trackSystem.new = function(...)
        local trackFunctions = originalTrackNew(...)
        local arguments = {...}

        -- Only execute automation if enabled and tracking local player
        if autoPlayerEnabled and arguments[2]._players._slots:get(arguments[3])._name == LocalPlayer.Name then
            for index, trackFunction in next, trackFunctions do 
                local upvalues = getupvalues(trackFunction)
                
                if type(upvalues[1]) == "table" and rawget(upvalues[1], "profilebegin") then 
                    local notesTable = upvalues[2]
                    trackFunctions[index] = function(self, slot, session)
                        local localTrackSys = getLocalTrackSystem(session)
                        local pressTrack, releaseTrack = getTrackActionFunctions(localTrackSys)

                        local testPressName = getconstant(pressTrack, 10)
                        local testReleaseName = getconstant(releaseTrack, 6)
                        noteTimeTarget = accuracyBounds[currentAccuracy]

                        for noteIndex = 1, notesTable:count() do 
                            local note = notesTable:get(noteIndex)
                            if note then 
                                local testPress = note[testPressName]
                                local testRelease = note[testReleaseName]
                                local noteTrackIndex = note:get_track_index(noteIndex)
                                
                                local pressed, _, pressDelay = testPress(note)
                                if pressed and pressDelay >= noteTimeTarget then
                                    pressTrack(localTrackSys, session, noteTrackIndex)
                                    session:debug_any_press()
                                    if rawget(note, "get_time_to_end") then
                                        releaseTrack(localTrackSys, session, noteTrackIndex)
                                    end
                                end

                                if testRelease then 
                                    local released, _, releaseDelay = testRelease(note)
                                    if released and releaseDelay >= noteTimeTarget then 
                                        releaseTrack(localTrackSys, session, noteTrackIndex)
                                    end
                                end
                            end
                        end
                        return trackFunction(self, slot, session)
                    end
                end
            end
        end
        return trackFunctions
    end
end

local function AutoPlayer(enable)
    autoPlayerEnabled = enable
    if enable and trackSystem and not originalTrackNew then
        SetupAutoPlayerHook()
    elseif not enable and originalTrackNew then
        trackSystem.new = originalTrackNew
        originalTrackNew = nil
    end
end

